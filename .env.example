# ====================================================
# Temporal-Multimodal-RAG Environment Configuration
# Copy this file to '.env' to customize settings
# ====================================================

# Network Binding
HOST=127.0.0.1
PORT=5000

# Development / Debugging
# Set to 'true' to enable Flask auto-reloader and tracebacks
FLASK_DEBUG=false

# Flask Session Security
# Generates a random session secret if omitted
FLASK_SECRET_KEY=temporal-rag-session-secret-key-2026

# Database Configuration (SQLAlchemy / SQLite)
# Defaults to sqlite:///learning_platform.db in project root
# DATABASE_URL=sqlite:///learning_platform.db
# DATABASE_PATH=learning_platform.db

# Whisper Speech Recognition Model
# Options: tiny, base, small, medium, large
WHISPER_MODEL=base

# Optional FFmpeg Path Override
# If not set, FFmpeg is dynamically resolved via imageio-ffmpeg or PATH
# FFMPEG_PATH=C:\path\to\ffmpeg.exe
# FFMPEG_DIR=C:\path\to\ffmpeg\bin

# ====================================================
# LLM Provider Configuration for Question Answering
# ====================================================
# Provider options: openai, gemini, groq, ollama, or custom
# If omitted, provider is automatically detected from available API keys.
# LLM_PROVIDER=openai

# Option A: OpenAI or OpenAI-Compatible Endpoints (OpenAI, Groq, Together, OpenRouter, vLLM, LMStudio)
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Option B: Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Option C: Groq Cloud
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant

# Option D: Local Ollama (No API key needed)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3

# Optional LLM Inference Settings
LLM_TIMEOUT=30
LLM_TEMPERATURE=0.2
